            showToast('Downloaded Abul_Basit_2k24_ITE_03_Resume.txt!');
        }

        // 7. Copy Email Helper (Using execCommand fallback for iFrame safety)
        function copyEmail() {
            const email = 'abul.basit.2k24ite03@example.com';
            const tempInput = document.createElement('input');
            tempInput.value = email;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast('Email copied: abul.basit.2k24ite03@example.com');
        }

        // 8. Interactive Contact Form Validation & Confirmation
        document.getElementById('contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('sender-name').value.trim();
            const email = document.getElementById('sender-email').value.trim();
            const message = document.getElementById('message').value.trim();
            const confirmationBox = document.getElementById('form-confirmation');

            if (!name || !email || !message) {
                showToast('Please complete your name, email, and message.', 'error');
                return;
            }
            if (!email.includes('@') || !email.includes('.')) {
                showToast('Please enter a valid email address.', 'error');
                return;
            }

            confirmationBox.classList.remove('hidden');
            showToast(`Thank you, ${name}! Your message has been sent.`);
            this.reset();
        });

        // Close modals on Escape key or backdrop click
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeProjectModal();
                closeResumeModal();
            }
        });
        projectModal.addEventListener('click', (e) => {
            if (e.target === projectModal) closeProjectModal();
        });
        resumeModal.addEventListener('click', (e) => {
            if (e.target === resumeModal) closeResumeModal();
        });
    </script>
